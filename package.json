{
  "name": "CHANGEME",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run docs:manifest",
    "start": "ng serve",
    "prebuild": "npm run docs:manifest",
    "build": "ng build",
    "docs:manifest": "ix-doc-manifest src/assets/markdown",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mcp": "tsx mcp/angular-mcp-server.ts",
    "mcp:start": "npm run mcp",
    "mcp:dev": "tsx watch mcp/angular-mcp-server.ts",
    "fresh": "rimraf node_modules && rimraf package-lock.json && npm i",
    "audit": "npm audit --json | npm-audit-html --output reports/build-audit.html ",
    "license-checker": "npm i -g npm-license-crawler && npm-license-crawler  --onlyDirectDependencies  --json src/assets/license.json",
    "update-cli": "ng update @angular/cli --force -C",
    "update-core": "ng update @angular/core --force -C",
    "update-material": "ng update @angular/material --force -C",
    "update-rxjs": "ng update rxjs --force -C",
    "update-all": "npm run update-cli && npm run update-core && npm run update-material && npm run update-rxjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@ng-select/ng-select": "^21.0.0",
    "@ngneat/bind-query-params": "^6.0.0",
    "@ngneat/hot-toast": "^7.0.0",
    "@ngneat/overview": "6.1.1",
    "@ngxpert/hot-toast": "^6.0.0",
    "@pyrophire/ix-libs": "^22.1.5",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "marked": "^18.0.10",
    "ngx-pipes": "^3.2.2",
    "npm-audit-html": "^1.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "~22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@ngneat/falso": "^7.2.0",
    "@ngneat/overview": "^5.1.1",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^22.8.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ngx-json-viewer": "^3.2.1",
    "prettier": "3.1",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3"
  }
}