{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#fff", // Background of selected tool on left bar
        "activityBar.activeBorder": "#ffbf00", // Color of left bar on selected tool
        "activityBar.background": "#005fb8", // Whole left bar
        "activityBar.foreground": "#000", // Selected left bar icon color
        "activityBar.inactiveForeground": "#e3e3e3", // Unselected left bar icon color
        "activityBarBadge.background": "#212121", // background of notification badge
        "activityBarBadge.foreground": "#ffffff", // text color of notification badge
        "titleBar.activeBackground": "#005fb8", // background of top bar
        "titleBar.activeForeground": "#ffffff", // color of text on top bar
        "titleBar.border": "#202e77", // color of bar under top bar
        "titleBar.inactiveBackground": "#005fb8", // color of top bar when not focused
        "titleBar.inactiveForeground": "#949494" // color of text background when not focused
    }
}